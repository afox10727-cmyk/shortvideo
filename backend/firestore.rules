rules_version = '2';
service cloud.firestore {

  // Helper functions
  function isAuth() { return request.auth != null; }
  function myUid() { return request.auth.uid; }
  function isMe(uid) { return isAuth() && uid == myUid(); }

  match /databases/{database}/documents {

    // ── Users ──
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isMe(uid) && request.resource.data.keys().hasAll([
        'username', 'displayName', 'bio', 'email',
        'followerCount', 'followingCount', 'videoCount'
      ]);
      allow update: if isMe(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['followerCount', 'followingCount', 'videoCount']);
      // Counter fields updated only by Cloud Functions
    }

    // ── Videos ──
    match /videos/{videoId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId
        && request.resource.data.processingStatus == 'uploading';
      allow update: if isAuth() &&
        (request.auth.uid == resource.data.userId ||
         // Cloud Functions bypass via admin SDK
         request.auth.uid == 'cloud-functions');
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;

      // ── Comments (subcollection of videos) ──
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
        allow delete: if isAuth() &&
          (request.auth.uid == resource.data.userId ||
           request.auth.uid == get(/databases/$(database)/documents/videos/$(videoId)).data.userId);
      }
    }

    // ── Follows ──
    match /follows/{followDoc} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.followerId;
      allow delete: if isAuth() && request.auth.uid == resource.data.followerId;
      // "I can only unfollow myself" (i.e., I can delete a doc where I'm the follower)
    }

    // ── Likes ──
    match /likes/{likeDoc} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuth() && request.auth.uid == resource.data.userId;
    }

    // ── Notifications ──
    match /notifications/{notifId} {
      allow read: if isAuth() && request.auth.uid == resource.data.recipientId;
      allow create: if false;  // Only Cloud Functions write
      allow update: if isAuth()
        && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    // ── Usernames ──
    match /usernames/{username} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth();
    }
  }
}
